# ═══════════════════════════════════════════════════════════
# EPL — Enterprise .gitignore
# ═══════════════════════════════════════════════════════════

# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/
*.so
*.dylib
*.whl
*.tar.gz

# ─── Virtual Environments ────────────────────────────────
.venv/
venv/
env/
.env

# ─── EPL Compiled Cache ──────────────────────────────────
*.eplc
__epl_cache__/

# ─── PyInstaller ─────────────────────────────────────────
epl/_internal/

# ─── Generated Output ────────────────────────────────────
site/
public/
*.o
*.ll
*.exe
screenshot/

# ─── Build Artifacts (generated via CI/CD) ───────────────
epl.spec
epl/runtime.o

# ─── Large Binary Assets (use GitHub Releases instead) ───
*.pdf
*.vsix
*.jar
*.gguf
*.bin

# ─── Logs ────────────────────────────────────────────────
*.log
*.log.*
build_output.log
test_output.log

# ─── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE & Editor ────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── Claude Code / AI Tools ──────────────────────────────
.claude/
.agent/
.gemini/
.kilo/
.sixth/
memory.md

# ─── VS Code Extension ──────────────────────────────────
vscode-extension/node_modules/
vscode-extension/*.vsix

# ─── Secrets — NEVER commit ──────────────────────────────
.pypirc
*.pem
*.key
*.env
.env.*
!.env.example
!.dev.vars.example
secrets.toml
credentials.json
epl/.ai_config.json

# ─── Test & Coverage ────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# ─── Jupyter ────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Large Model Files ──────────────────────────────────
epl/models/

# ─── Temp Files ─────────────────────────────────────────
tmp/
temp/
*.tmp
_tmp_*.py
_tmp_*.epl
test_tmp.*

# ─── Editor backups & generated previews ────────────────
*.bak
*.bak[0-9]
*.orig
/preview*.html

# ─── Local Automation Scripts ───────────────────────────
run_background.bat
start_bot_silently.vbs
stop_bot.bat

# ─── Transpiled Output (generated by epl js/kt/py) ──────
hello.js
hello.kt
hello.py
functions.js
functions.kt
functions.py
variables.py
classes.py
advanced.py

# ─── Root Scratch Files ─────────────────────────────────
/test_*.py
/test.js
test[0-9]*.epl
test_[0-9]*.epl
playground_*.epl

# ─── SQLite Databases (generated by apps) ───────────────
*.db

# ─── Release Build Folders ──────────────────────────────
/eplang-*/
/epl_lang-*/
_release_check*/

# ─── Fuzzing Output ─────────────────────────────────────
fuzz_*.txt
fuzz_out*

# ─── Removed Directories (legacy/demo) ──────────────────
ios_demo_ios/
epl_packages/
# Ignore packages/ contents (installed-package cache) but KEEP the
# reference-hello-lib fixture the reference-apps test suite needs. Use
# packages/* (not packages/) so git can still descend to re-include it.
packages/*
!packages/reference-hello-lib/
plans/
functions/

# ─── Wrangler / Cloudflare ──────────────────────────────
.wrangler
.dev.vars*

# ─── Agent chat exports (may contain pasted secrets) ────
chat_export.*
*chat_export*

# ─── Website (lives in its own repo: epl-website) ───────
# The standalone site repo is sometimes checked out nested inside this
# working tree. Ignore it here so it never shows as clutter or gets
# accidentally committed into the core language repo.
epl-website/

# ─── SQLite WAL/SHM sidecars (generated alongside *.db) ──
*.db-shm
*.db-wal

# ─── Test/example run scratch (generated by running examples & tests) ───
_probe/
_audit/
_tmpdoc/
/data.json
/data.txt
/output.txt
