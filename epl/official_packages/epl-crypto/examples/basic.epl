Note: EPL Crypto Package — Basic Usage Examples
Import "epl-crypto"

Say "=== EPL Crypto Demo ==="

Note: AES Encryption
Say ""
Say "--- AES-256 Encryption ---"
secret_key = aes_generate_key()
Say "Key generated: " + secret_key

encrypted = aes_encrypt("Hello from EPL! This is secret.", secret_key)
Say "Encrypted: " + encrypted

decrypted = aes_decrypt(encrypted, secret_key)
Say "Decrypted: " + decrypted

Note: Password-based encryption
Say ""
Say "--- Password Encryption ---"
sealed = password_encrypt("Top secret project data", "my_strong_password")
Say "Password encrypted: " + sealed

opened = password_decrypt(sealed, "my_strong_password")
Say "Password decrypted: " + opened

Note: RSA Key Pair
Say ""
Say "--- RSA Encryption ---"
keys = rsa_generate_keypair(2048)
pub_key = rsa_public_key_from(keys)
priv_key = rsa_private_key_from(keys)
Say "RSA keypair generated (2048-bit)"

rsa_encrypted = rsa_encrypt("Secret for recipient", pub_key)
Say "RSA encrypted: " + rsa_encrypted

rsa_decrypted = rsa_decrypt(rsa_encrypted, priv_key)
Say "RSA decrypted: " + rsa_decrypted

Note: Digital Signature
Say ""
Say "--- Digital Signatures ---"
msg = "This document is authentic"
signature = sign_message(msg, priv_key)
Say "Signature: " + signature

is_valid = verify_signature(msg, signature, pub_key)
Say "Signature valid: " + is_valid

Note: Encoding
Say ""
Say "--- Base64 Encoding ---"
b64 = to_base64("Hello EPL Crypto!")
Say "Base64: " + b64
decoded = from_base64(b64)
Say "Decoded: " + decoded

Note: Secure Random
random_token = secure_random_hex(32)
Say ""
Say "Random token: " + random_token

Say ""
Say "=== Done! ==="
