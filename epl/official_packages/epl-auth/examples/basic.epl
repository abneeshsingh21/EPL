Note: EPL Auth Package — Basic Usage Examples
Import "epl-auth"

Say "=== EPL Auth Package Demo ==="

Note: Password Hashing
Say ""
Say "--- Password Hashing ---"
password = "SuperSecret123!"
hashed = hash_password(password)
Say "Original: " + password
Say "Hashed: " + hashed

is_valid = verify_password("SuperSecret123!", hashed)
Say "Verify correct password: " + is_valid

is_wrong = verify_password("wrong_password", hashed)
Say "Verify wrong password: " + is_wrong

Note: JWT Tokens
Say ""
Say "--- JWT Tokens ---"
secret = "my-app-secret-key"
user_id = 42
token = create_token(Map, secret, 24)
Say "Token created: " + token

expired = is_token_expired(token, secret)
Say "Is expired: " + expired

Note: API Key Generation
Say ""
Say "--- API Keys ---"
api_key = generate_api_key("epl")
Say "Generated API key: " + api_key

my_secret = generate_secret(32)
Say "Random secret: " + my_secret

id = generate_uuid()
Say "UUID: " + id

Note: Hashing
Say ""
Say "--- Hashing ---"
digest = hash_sha256("Hello EPL!")
Say "SHA-256 of 'Hello EPL!': " + digest

Note: Input Validation
Say ""
Say "--- Validation ---"
Say "Is 'user@example.com' valid email: " + is_valid_email("user@example.com")
Say "Is 'not-an-email' valid: " + is_valid_email("not-an-email")
Say "Is 'Str0ng!Pass' strong: " + is_strong_password("Str0ng!Pass")
Say "Is 'weak' strong: " + is_strong_password("weak")

Say ""
Say "=== Done! ==="
