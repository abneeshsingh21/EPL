Note "EPL Standard Library: regex — Regular Expressions"
Note "Match, find, replace, split, compile, groups"

Function match takes pattern and value
    Return regex_match(pattern, value)
End

Function find takes pattern and value
    Return regex_find(pattern, value)
End

Function find_all takes pattern and value
    Return regex_find_all(pattern, value)
End

Function replace takes pattern and value and replacement
    Return regex_replace(pattern, value, replacement)
End

Function split takes pattern and value
    Return regex_split(pattern, value)
End

Function test takes pattern and value
    Return regex_test(pattern, value)
End

Function escape takes value
    Return regex_escape(value)
End

Function compile takes pattern and flags
    Return regex_compile(pattern, flags)
End

Function groups takes pattern and value
    Return regex_groups(pattern, value)
End
