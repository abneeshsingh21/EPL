# =============================================================================
# .gitattributes — EPL Language (Main Repository)
# =============================================================================
# PURPOSE: Ensure GitHub Linguist correctly attributes all EPL source files
#          in this repo to the EPL language, and excludes Python infrastructure
#          (interpreter, compiler, stdlib, tooling) from the language bar.
#
# RATIONALE: The primary artifact of this repo IS the EPL language runtime,
#            which happens to be implemented in Python. Without these overrides,
#            Linguist would report "Python 100%" — accurate about the impl
#            language, but misleading about what the repo *is*.
#
# LAYERS:
#   1. All .epl sample/example/test files → counted as EPL
#   2. All .py interpreter/compiler files → vendored (excluded from bar)
#   3. Generated, docs, and config files  → excluded from bar
# =============================================================================

# ── EPL source and sample files ───────────────────────────────────────────────
*.epl                       linguist-language=EPL
*.epl                       linguist-detectable=true

# ── Python implementation files — vendored (this repo *is* EPL, not Python) ──
# The Python files are the implementation vehicle, not the primary language.
epl/**/*.py                 linguist-vendored=true
*.py                        linguist-vendored=true

# ── Tests — mark as documentation so they don't skew the bar ─────────────────
tests/**                    linguist-documentation=true

# ── VS Code extension — vendored (tooling, not primary source) ────────────────
vscode-extension/**         linguist-vendored=true

# ── Official packages — these are EPL packages, keep .epl files counted ───────
official_packages/**/*.epl  linguist-language=EPL
official_packages/**/*.epl  linguist-detectable=true
official_packages/**/*.py   linguist-vendored=true

# ── Landing page — EPL source counts; generated dist/ excluded ────────────────
landing_page/src/**/*.epl   linguist-language=EPL
landing_page/src/**/*.epl   linguist-detectable=true
landing_page/dist/**        linguist-generated=true
landing_page/**/*.py        linguist-vendored=true

# ── CI / GitHub Actions ───────────────────────────────────────────────────────
.github/**                  linguist-vendored=true

# ── Documentation, config, requirements ──────────────────────────────────────
*.md                        linguist-documentation=true
*.txt                       linguist-documentation=true
*.toml                      linguist-documentation=true
*.yml                       linguist-vendored=true
*.yaml                      linguist-vendored=true
