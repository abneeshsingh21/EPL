# =============================================================================
# .gitattributes — EPL Language (Main Repository)
# =============================================================================
# STRATEGY: Map .epl → Python as a temporary fallback (gives real highlighting)
# and vendor ONLY pure build/CI tooling. The core Python implementation files
# (epl/*.py) are intentionally left as Python — they ARE the primary source of
# this repo and should appear in the language bar alongside the EPL samples.
# =============================================================================

# ── EPL source and sample files ───────────────────────────────────────────────
# Temporary fallback until github-linguist/linguist officially adds EPL.
*.epl   linguist-language=Python
*.epl   linguist-detectable=true

# ── Build / CI tooling — vendor these (not primary source) ───────────────────
# Landing page build helpers
landing_page/build_static.py        linguist-vendored=true
landing_page/deploy.py              linguist-vendored=true
assets/make_og.py                   linguist-vendored=true

# Generated output
landing_page/dist/**                linguist-generated=true

# GitHub Actions and CI
.github/**                          linguist-vendored=true

# VS Code extension (tooling, not language source)
vscode-extension/**                 linguist-vendored=true

# ── Documentation ─────────────────────────────────────────────────────────────
docs/**                             linguist-documentation=true
*.md                                linguist-documentation=true
