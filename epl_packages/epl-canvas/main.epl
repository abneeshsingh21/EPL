Note: epl-canvas — Enhanced 2D canvas drawing system for EPL
Note: Draw shapes, sprites, text, and build games with declarative canvas commands.
Note: Usage: Draw "rect" x 10 y 10 width 100 height 50 fill "#ff0000"

Note: ═══════════════════════════════════════════
Note: CANVAS CONTAINER STYLES
Note: ═══════════════════════════════════════════

Style "canvas-container"
    Width "100%"
    Height "500px"
    Position "relative"
    Background "#000000"
    BorderRadius "8px"
    Overflow "hidden"
End

Style "canvas-game"
    Width "800px"
    Height "600px"
    Margin "0 auto"
    Background "#1a1a2e"
    Border "2px solid #333"
    ImageRendering "pixelated"
End

Style "canvas-pixel-art"
    Width "512px"
    Height "512px"
    ImageRendering "pixelated"
    Background "#2d2d2d"
    Border "1px solid #555"
End

Style "canvas-fullscreen"
    Width "100vw"
    Height "100vh"
    Position "fixed"
    Top "0"
    Left "0"
    Background "#000"
End

Note: ═══════════════════════════════════════════
Note: COLOR PALETTE STYLES
Note: ═══════════════════════════════════════════

Style "palette-retro"
    Background "#0f380f"
    Color "#9bbc0f"
End

Style "palette-neon"
    Background "#0a0a0a"
    Color "#00ff88"
End

Style "palette-pastel"
    Background "#fef9ef"
    Color "#2d3436"
End

Style "palette-cyberpunk"
    Background "#0d0221"
    Color "#ff00ff"
End

Note: ═══════════════════════════════════════════
Note: GAME UI STYLES
Note: ═══════════════════════════════════════════

Style "game-hud"
    Position "absolute"
    Top "10px"
    Left "10px"
    Color "#ffffff"
    FontFamily "monospace"
    FontSize "14px"
    TextShadow "1px 1px 2px rgba(0,0,0,0.8)"
End

Style "game-score"
    Position "absolute"
    Top "10px"
    Right "10px"
    Color "#ffdd00"
    FontFamily "monospace"
    FontSize "24px"
    FontWeight "bold"
End

Style "game-overlay"
    Position "absolute"
    Top "0"
    Left "0"
    Width "100%"
    Height "100%"
    Background "rgba(0,0,0,0.7)"
    Display "flex"
    JustifyContent "center"
    AlignItems "center"
    Color "#ffffff"
    FontSize "48px"
End

Style "game-button"
    Padding "12px 32px"
    Background "#4CAF50"
    Color "#fff"
    Border "none"
    BorderRadius "6px"
    FontSize "18px"
    Cursor "pointer"
End

Note: ═══════════════════════════════════════════
Note: SPRITE ANIMATION STYLES
Note: ═══════════════════════════════════════════

Animate "sprite-walk"
    Duration "0.6s"
    Easing "steps(4)"
    Keyframe 0
        Transform "translateX(0)"
    End
    Keyframe 100
        Transform "translateX(-128px)"
    End
End

Animate "sprite-jump"
    Duration "0.4s"
    Easing "ease-out"
    Keyframe 0
        Transform "translateY(0)"
    End
    Keyframe 50
        Transform "translateY(-40px)"
    End
    Keyframe 100
        Transform "translateY(0)"
    End
End

Animate "sprite-idle"
    Duration "1.2s"
    Easing "ease-in-out"
    Keyframe 0
        Transform "translateY(0px)"
    End
    Keyframe 50
        Transform "translateY(-3px)"
    End
    Keyframe 100
        Transform "translateY(0px)"
    End
End

Animate "particle-burst"
    Duration "0.8s"
    Easing "ease-out"
    Keyframe 0
        Opacity "1"
        Transform "scale(0) translate(0, 0)"
    End
    Keyframe 100
        Opacity "0"
        Transform "scale(1) translate(20px, -30px)"
    End
End

Animate "screen-shake"
    Duration "0.3s"
    Easing "ease-out"
    Keyframe 0
        Transform "translate(0, 0)"
    End
    Keyframe 25
        Transform "translate(-5px, 3px)"
    End
    Keyframe 50
        Transform "translate(5px, -3px)"
    End
    Keyframe 75
        Transform "translate(-3px, 2px)"
    End
    Keyframe 100
        Transform "translate(0, 0)"
    End
End

Note: ═══════════════════════════════════════════
Note: DRAW COMMAND EXAMPLES
Note: ═══════════════════════════════════════════

Draw "rect" x 50 y 50 width 200 height 100 fill "#4CAF50"
Draw "circle" x 400 y 150 radius 50 fill "#2196F3"
Draw "line" x1 10 y1 10 x2 300 y2 200 stroke "#ffffff" width 2
Draw "text" x 50 y 300 content "Score: 0" font "24px monospace" fill "#ffdd00"
Draw "path" points "M100,100 L200,50 L300,100 Z" fill "#ff6b6b" stroke "#fff"
Draw "rect" x 0 y 550 width 800 height 50 fill "#333333"
