Note: TRANSITION UTILITIES
Note: ═══════════════════════════════════════════

Style "transition"
    Transition "all 0.2s ease"
End

Style "transition-fast"
    Transition "all 0.15s ease"
End

Style "transition-slow"
    Transition "all 0.3s ease"
End

Style "cursor-pointer"
    Cursor "pointer"
End

Style "select-none"
    User select "none"
End

Style "opacity-50"
    Opacity "0.5"
End

Style "opacity-75"
    Opacity "0.75"
End

Style "opacity-0"
    Opacity "0"
End
