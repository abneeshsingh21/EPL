Note: epl-3d — Declarative 3D scene system for EPL
Note: Powered by Three.js. Define scenes, cameras, lights, and meshes in plain English.
Note: Usage: Scene "myScene" width 800 height 600 ... End

Note: ═══════════════════════════════════════════
Note: SCENE STYLES
Note: ═══════════════════════════════════════════

Style "scene-container"
    Width "100%"
    Height "600px"
    Position "relative"
    Overflow "hidden"
    BorderRadius "8px"
    Background "#1a1a2e"
End

Style "scene-fullscreen"
    Width "100vw"
    Height "100vh"
    Position "fixed"
    Top "0"
    Left "0"
End

Style "scene-card"
    Width "100%"
    Height "400px"
    BorderRadius "12px"
    Overflow "hidden"
    BoxShadow "0 8px 32px rgba(0,0,0,0.3)"
End

Note: ═══════════════════════════════════════════
Note: MATERIAL PRESETS
Note: ═══════════════════════════════════════════

Style "material-metallic"
    Background "linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
End

Style "material-glass"
    Background "rgba(255,255,255,0.1)"
    Backdrop "blur(10px)"
    Border "1px solid rgba(255,255,255,0.2)"
End

Style "material-neon"
    Background "#0f0f23"
    BoxShadow "0 0 20px #00ff88, 0 0 40px #00ff88"
End

Style "material-gold"
    Background "linear-gradient(135deg, #f5af19 0%, #f12711 100%)"
End

Style "material-hologram"
    Background "linear-gradient(135deg, #00c9ff 0%, #92fe9d 100%)"
    Opacity "0.8"
End

Note: ═══════════════════════════════════════════
Note: LIGHTING PRESETS
Note: ═══════════════════════════════════════════

Style "lighting-studio"
    Background "radial-gradient(ellipse at top, #2d2d44 0%, #1a1a2e 100%)"
End

Style "lighting-sunset"
    Background "linear-gradient(180deg, #ff6b35 0%, #f7c59f 30%, #2e1a47 100%)"
End

Style "lighting-night"
    Background "radial-gradient(ellipse at center, #16213e 0%, #0f3460 50%, #1a1a2e 100%)"
End

Style "lighting-underwater"
    Background "linear-gradient(180deg, #006994 0%, #003d5b 50%, #001524 100%)"
End

Note: ═══════════════════════════════════════════
Note: 3D SCENE EXAMPLES
Note: ═══════════════════════════════════════════

Scene "demo-cube" width 800 height 600
    Camera position 0, 5, 10 look_at 0, 0, 0 fov 75
    Light "ambient" color "#ffffff" intensity 0.4
    Light "directional" color "#ffffff" intensity 0.8 position 5, 10, 5
    Mesh "cube" position 0, 0, 0 color "#667eea"
End

Scene "demo-solar" width 800 height 600
    Camera position 0, 20, 40 look_at 0, 0, 0 fov 60
    Light "ambient" color "#111133" intensity 0.3
    Light "point" color "#ffaa00" intensity 2.0 position 0, 0, 0
    Mesh "sphere" position 0, 0, 0 scale 3, 3, 3 color "#ffaa00"
    Mesh "sphere" position 8, 0, 0 scale 0, 0, 0 color "#4488ff"
    Mesh "sphere" position 14, 0, 0 scale 1, 1, 1 color "#ff4444"
    Mesh "sphere" position 20, 0, 0 scale 1, 1, 1 color "#88ff44"
End

Scene "demo-landscape" width 800 height 600
    Camera position 0, 5, 15 look_at 0, 0, 0 fov 60
    Light "ambient" color "#87ceeb" intensity 0.5
    Light "directional" color "#ffffff" intensity 1.0 position 10, 20, 10
    Mesh "plane" position 0, 0, 0 scale 50, 1, 50 color "#4caf50"
    Mesh "cube" position -3, 1, 0 color "#8b4513"
    Mesh "cube" position 3, 1, -2 color "#8b4513"
    Mesh "sphere" position -3, 3, 0 scale 2, 2, 2 color "#2e7d32"
    Mesh "sphere" position 3, 3, -2 scale 2, 2, 2 color "#388e3c"
End

Note: ═══════════════════════════════════════════
Note: 3D ANIMATION STYLES
Note: ═══════════════════════════════════════════

Animate "rotate3d"
    Duration "4s"
    Easing "linear"
    Keyframe 0
        Transform "rotateY(0deg)"
    End
    Keyframe 100
        Transform "rotateY(360deg)"
    End
End

Animate "float3d"
    Duration "3s"
    Easing "ease-in-out"
    Keyframe 0
        Transform "translateY(0px)"
    End
    Keyframe 50
        Transform "translateY(-10px)"
    End
    Keyframe 100
        Transform "translateY(0px)"
    End
End

Animate "pulse3d"
    Duration "2s"
    Easing "ease-in-out"
    Keyframe 0
        Transform "scale(1)"
    End
    Keyframe 50
        Transform "scale(1.05)"
    End
    Keyframe 100
        Transform "scale(1)"
    End
End

Animate "orbit"
    Duration "8s"
    Easing "linear"
    Keyframe 0
        Transform "rotateY(0deg) translateX(10px) rotateY(0deg)"
    End
    Keyframe 100
        Transform "rotateY(360deg) translateX(10px) rotateY(-360deg)"
    End
End
