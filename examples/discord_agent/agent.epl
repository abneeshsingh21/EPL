Note: EPL KNOWLEDGE BASE — Accurate, real syntax with working examples
Note: ═══════════════════════════════════════════════════════════════

Create EPL_KNOWLEDGE equal to "EPL (English Programming Language) is created by Abneesh Singh. Install: pip install eplang. Run: epl run file.epl. REPL: epl repl. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "CRITICAL SYNTAX RULES — You MUST follow these exactly when writing EPL code: "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "1. Strings MUST be in double quotes: " + "\x22" + "Hello" + "\x22" + ". NEVER write bare text without quotes. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "2. Variables: Create name equal to " + "\x22" + "Abneesh" + "\x22" + " (correct). NEVER write 'Create a variable called'. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "3. Print: Say " + "\x22" + "Hello World" + "\x22" + " or Display " + "\x22" + "Hello" + "\x22" + ". "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "4. If blocks: If x > 5 then ... Otherwise ... End. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "5. Loops: For Each item in list ... End. Repeat 3 times ... End. While x < 10 ... End. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "6. Functions: Function add takes a, b ... Return a + b ... End. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "7. Classes: Class User has name, email ... Method greet ... End ... End. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "8. Web: Create WebApp called app ... Route /path responds with ... End. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "9. Maps: Map with key1 = val1 and key2 = val2. Lists: [1, 2, 3]. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "10. String concat uses +: Say " + "\x22" + "Hello " + "\x22" + " + name. "

Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "CORRECT CODE EXAMPLES (copy these patterns exactly): "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "Example 1 - Hello World: ```epl\nCreate greeting equal to " + "\x22" + "Hello, World!" + "\x22" + "\nSay greeting\n``` "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "Example 2 - Variables & Math: ```epl\nCreate age equal to 25\nCreate name equal to " + "\x22" + "Abneesh" + "\x22" + "\nSay " + "\x22" + "Name: " + "\x22" + " + name\nSay " + "\x22" + "Age: " + "\x22" + " + age\n``` "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "Example 3 - Function: ```epl\nFunction greet takes person\n    Say " + "\x22" + "Hello, " + "\x22" + " + person + " + "\x22" + "!" + "\x22" + "\nEnd\ngreet(" + "\x22" + "Abneesh" + "\x22" + ")\n``` "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "Example 4 - If/Else: ```epl\nCreate score equal to 85\nIf score >= 90 then\n    Say " + "\x22" + "Grade: A" + "\x22" + "\nOtherwise If score >= 80 then\n    Say " + "\x22" + "Grade: B" + "\x22" + "\nOtherwise\n    Say " + "\x22" + "Grade: C" + "\x22" + "\nEnd\n``` "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "Example 5 - Loop: ```epl\nCreate fruits equal to [" + "\x22" + "apple" + "\x22" + ", " + "\x22" + "banana" + "\x22" + ", " + "\x22" + "cherry" + "\x22" + "]\nFor Each fruit in fruits\n    Say fruit\nEnd\n``` "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "Example 6 - Class: ```epl\nClass User has name, email\n    Method greet\n        Say " + "\x22" + "Hi, I am " + "\x22" + " + this.name\n    End\nEnd\nCreate u equal to new User with name = " + "\x22" + "Abneesh" + "\x22" + " and email = " + "\x22" + "a@epl.dev" + "\x22" + "\nu.greet()\n``` "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "Example 7 - WebApp: ```epl\nCreate WebApp called api\nRoute /hello responds with\n    Send json Map with message = " + "\x22" + "Hello from EPL!" + "\x22" + "\nEnd\nStart api on port 3000\n``` "

Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "Built-in modules: math, string, http, json, crypto, datetime, regex, io, os, sql, net, websocket, collections, encoding, functional, auth, template, testing. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "CLI: epl run (interpret), epl build (LLVM binary), epl wasm, epl js, epl kotlin, epl ios, epl desktop. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "22 packages: epl-web, epl-http, epl-db, epl-dataframe, epl-learn, epl-array, epl-plot, epl-math, epl-auth, epl-crypto, epl-cloud, epl-cache, epl-test, etc. "
Set EPL_KNOWLEDGE to EPL_KNOWLEDGE + "GitHub: https://github.com/abneeshsingh21/EPL. Docs: https://abneeshsingh21.github.io/EPL/. PyPI: https://pypi.org/project/eplang/. "

Note: ═══════════════════════════════════════════════════════════════
Note: FAQ AUTO-REPLY — Instant responses, no LLM needed
Note: ═══════════════════════════════════════════════════════════════

Function faq_check takes message
    Create msg equal to message.lower().trim()

    If msg.contains("how to install") or msg.contains("how do i install") or msg is equal to "install epl" then
        Return "**Installing EPL is easy!** 🚀\n```bash\npip install eplang\n```\nThen run your first program:\n```bash\nepl run hello.epl\n```\nOr try the interactive REPL: `epl repl`"
    End

    If msg is equal to "what is epl" or msg is equal to "what is epl?" or msg.contains("what is epl") then
        Return "**EPL (English Programming Language)** is a fully-featured programming language where every keyword is natural English! 🌟\n\n```epl\nCreate message equal to " + "\x22" + "Hello, World!" + "\x22" + "\nSay message\n```\n\n📦 Install: `pip install eplang`\n📚 Docs: https://abneeshsingh21.github.io/EPL/\n⭐ GitHub: https://github.com/abneeshsingh21/EPL"
    End

    If msg.contains("what ide") or msg.contains("which editor") or msg.contains("vscode extension") then
        Return "**EPL has a VS Code extension!** 🎨\nSearch for `EPL` in the VS Code marketplace. It provides:\n• Syntax highlighting\n• IntelliSense\n• Error diagnostics\n• Code formatting (`epl fmt`)"
    End

    If msg.contains("how to run") or msg.contains("how do i run") then
        Return "**Running EPL code:**\n```bash\nepl run myfile.epl\n```\nOr use the interactive REPL:\n```bash\nepl repl\n```"
    End

    If msg.contains("epl vs python") or msg.contains("why epl") or msg.contains("why not python") then
        Return "**EPL vs Python:**\n• EPL uses **natural English** keywords (`Create`, `Say`, `For Each`)\n• EPL compiles to **native binaries** via LLVM (faster than Python)\n• EPL transpiles to **JS, Kotlin, WASM, Swift**\n• EPL has built-in **web framework** (`Create WebApp`)\n• Python has a larger ecosystem, EPL is newer but growing! 🚀"
    End

    Return ""
End

Note: ═══════════════════════════════════════════════════════════════
Note: BUILD CONTEXT-AWARE SYSTEM PROMPT
Note: ═══════════════════════════════════════════════════════════════

Function build_system_prompt takes username, channel_id
    Create prompt equal to "You are EPLAI, the official AI assistant of the EPL Discord Server. "
    Set prompt to prompt + EPL_KNOWLEDGE

    Note: --- RESPONSE RULES ---
    Set prompt to prompt + "RESPONSE RULES (CRITICAL): "
    Set prompt to prompt + "1. Be CONCISE. Match your response length to the question length. Short question = short answer (2-4 lines). Complex question = detailed answer. "
    Set prompt to prompt + "2. ALWAYS use Discord markdown code blocks with ```epl for EPL code. NEVER write code as plain text. "
    Set prompt to prompt + "3. Give ONE clear example per concept, not multiple alternatives. "
    Set prompt to prompt + "4. Strings in EPL MUST always be in double quotes. NEVER write bare unquoted text. "
    Set prompt to prompt + "5. NEVER write 'Create a variable called'. The correct syntax is 'Create name equal to value'. "
    Set prompt to prompt + "6. NEVER explain what IGNORE means or mention it in your response. If you want to ignore, just output IGNORE alone. "

    Note: --- TOOLS ---
    Set prompt to prompt + "TOOLS (output ONLY the command, nothing else): "
    Set prompt to prompt + "SEARCH:<query> | WEATHER:<location> | CALCULATE:<expr> | NEWS:<topic> | REMEMBER:<fact> | LEARN:<topic>|<info> | GENERATE_IMAGE:<prompt> | "
    Set prompt to prompt + "CREATE_ROLE:<name>|<hex_color> (founder only) | CREATE_CHANNEL:<name>|<type> (founder only) | "
    Set prompt to prompt + "SCAN_SERVER:trigger | BROADCAST:<channel_id>|<message> | CHECK_GITHUB:trigger "

    Note: ═══ FOUNDER MODE ═══
    If username is equal to "abneesh.dev" then
        If channel_id is equal to CH_BOT_CONTROL then
            Set prompt to prompt + "MODE: FOUNDER COMMAND CENTER. Speaking with Abneesh Singh (Founder) in #bot-control. "
            Set prompt to prompt + "Act as Senior Assistant. Be strategic, concise, action-oriented. Any topic is allowed. Execute tasks using tools. "
        Else
            Set prompt to prompt + "MODE: FOUNDER. User is Abneesh Singh, EPL Founder. Top priority. Any topic allowed. Be helpful, professional, concise. "
        End
        Return prompt
    End

    Note: ═══ AUTONOMOUS MODE ═══
    If username is equal to "SYSTEM_AUTONOMOUS" then
        Set prompt to prompt + "MODE: AUTONOMOUS. Execute routine: CHECK_GITHUB:trigger, then BROADCAST results to #announcements (1507812398499893349), then BROADCAST a daily EPL tip to #general (1507812597431402707). "
        Return prompt
    End

    Note: ═══ COMMUNITY MEMBER MODES ═══
    If channel_id is equal to CH_ASK_EPLAI or channel_id is equal to CH_EPL_HELP then
        Set prompt to prompt + "MODE: HELP. Answer ALL EPL and programming questions helpfully with correct code examples. Be friendly and patient. Only IGNORE pure spam/gibberish. "
        Return prompt
    End

    If channel_id is equal to CH_BUG_REPORTS then
        Set prompt to prompt + "MODE: BUG REPORTS. Help users report bugs. Ask for: EPL version, OS, error message, reproduction steps. Be systematic. "
        Return prompt
    End

    If channel_id is equal to CH_GENERAL or channel_id is equal to CH_LOBBY then
        Set prompt to prompt + "MODE: COMMUNITY. Be friendly and engaging. Answer EPL questions with code. Only IGNORE if message is just 'hi'/'hello' with nothing else. Redirect off-topic politely. "
        Return prompt
    End

    If channel_id is equal to CH_SHOWCASE then
        Set prompt to prompt + "MODE: SHOWCASE. Give positive, constructive feedback on user projects. Be encouraging. "
        Return prompt
    End

    If channel_id is equal to CH_OFF_TOPIC then
        Set prompt to prompt + "MODE: CASUAL. Friendly casual chat about tech. Only IGNORE pure spam. "
        Return prompt
    End

    Set prompt to prompt + "MODE: DEFAULT. Answer EPL questions helpfully. Only IGNORE pure spam. Redirect off-topic politely. "
    Return prompt
End

Note: ═══════════════════════════════════════════════════════════════
Note: API CALL FUNCTION
Note: ═══════════════════════════════════════════════════════════════

Function agent_call_api takes api_key, messages, model_to_use, endpoint_url
    Create body equal to json_stringify(Map with model = model_to_use and messages = messages and temperature = 0.7 and max_tokens = 2048)
    If endpoint_url.contains("azure.com") then
        Set body to json_stringify(Map with model = model_to_use and messages = messages and temperature = 0.7 and max_completion_tokens = 2048)
    End
    Set body to body.replace("\x22k_type\x22:", "\x22type\x22:")
    Set body to body.replace("\x22k_img\x22:", "\x22image_url\x22:")
    Set body to body.replace("\x22k_text\x22:", "\x22text\x22:")
    
    Create headers equal to dict_from_lists(["Authorization", "Content-Type"], ["Bearer " + api_key, "application/json"])
    If endpoint_url.contains("azure.com") then
        Set headers to dict_from_lists(["api-key", "Content-Type"], [api_key, "application/json"])
    End
    
    Create response equal to http_post(endpoint_url, body, headers)
    If response.status is not equal to 200 then
        Say "API Error " + response.status + ": " + response.body
        Return Nothing
    End

    Create data equal to response.body
    Return data["choices"][0]["message"]["content"]
End

Note: ═══════════════════════════════════════════════════════════════
Note: MAIN AGENT PROCESS
Note: ═══════════════════════════════════════════════════════════════

Function agent_process takes db, user_id, username, user_message, api_key, image_url, guild_id, token, channel_id
    Note: Check FAQ first (instant, no LLM)
    Create faq_answer equal to faq_check(user_message)
    If faq_answer is not equal to "" then
        memory_save_message(db, user_id, username, "user", user_message)
        memory_save_message(db, user_id, username, "assistant", faq_answer)
        Return faq_answer
    End

    Create history equal to memory_get_history(db, user_id)
    Create facts equal to memory_get_facts(db, user_id)
    Create system_prompt equal to build_system_prompt(username, channel_id)

    Create messages equal to []
    messages.add(Map with role = "system" and content = system_prompt)

    If length(facts) > 0 then
        Create fact_str equal to facts.join(", ")
        messages.add(Map with role = "system" and content = "Known facts about this user: " + fact_str)
    End

    Create profile equal to memory_get_profile(db, user_id)
    If profile is not equal to "" then
        messages.add(Map with role = "system" and content = "User profile: " + profile)
    End

    For Each msg in history
        messages.add(msg)
    End

    Create azure_api_key equal to env_get("AZURE_API_KEY")
    Create model_to_use equal to GROQ_MODEL
    Create target_url equal to GROQ_URL
    Create active_api_key equal to api_key

    If image_url is not equal to "" then
        Set model_to_use to "llama-3.2-11b-vision-preview"
        Set target_url to "https://api.groq.com/openai/v1/chat/completions"
        Create text_obj equal to Map with k_type = "text" and k_text = "[" + username + "]: " + user_message
        Create img_url_obj equal to Map with url = image_url
        Create img_obj equal to Map with k_type = "image_url" and k_img = img_url_obj
        Create content_arr equal to []
        content_arr.add(text_obj)
        content_arr.add(img_obj)
        messages.add(Map with role = "user" and content = content_arr)
    Else
        messages.add(Map with role = "user" and content = "[" + username + "]: " + user_message)
    End

    Create max_steps equal to 8
    Create step equal to 0
    Create is_autonomous equal to False
    If username is equal to "SYSTEM_AUTONOMOUS" then
        Set is_autonomous to True
    End

    While step < max_steps
        Create llm_reply equal to agent_call_api(active_api_key, messages, model_to_use, target_url)
        
        If llm_reply is equal to Nothing then
            If target_url is equal to GROQ_URL then
                Say "[Agent] Groq failed, falling back to Azure..."
                Set target_url to AZURE_URL
                Set model_to_use to AZURE_MODEL
                Set active_api_key to azure_api_key
                Set llm_reply to agent_call_api(active_api_key, messages, model_to_use, target_url)
            End
            If llm_reply is equal to Nothing then
                Return "I'm experiencing API issues. Please try again shortly."
            End
        End
        
        Set step to step + 1
        Set llm_reply to llm_reply.trim()

        Note: Robust IGNORE detection
        If llm_reply is equal to "IGNORE" or llm_reply.starts_with("IGNORE") then
            Return "IGNORE"
        End
        If llm_reply.contains("IGNORE") and length(llm_reply) < 500 then
            Return "IGNORE"
        End

        If llm_reply.starts_with("SEARCH:") then
            Create query equal to llm_reply.replace("SEARCH:", "").trim()
            Say "[Agent] Searching: " + query
            Create search_result equal to tool_web_search(query)
            messages.add(Map with role = "assistant" and content = llm_reply)
            messages.add(Map with role = "system" and content = "Search result: " + search_result)

        Otherwise If llm_reply.starts_with("WEATHER:") then
            Create loc equal to llm_reply.replace("WEATHER:", "").trim()
            Create w_result equal to tool_weather(loc)
            messages.add(Map with role = "assistant" and content = llm_reply)
            messages.add(Map with role = "system" and content = w_result)

        Otherwise If llm_reply.starts_with("CALCULATE:") then
            Create expr equal to llm_reply.replace("CALCULATE:", "").trim()
            Create calc_result equal to tool_calculate(expr)
            messages.add(Map with role = "assistant" and content = llm_reply)
            messages.add(Map with role = "system" and content = calc_result)

        Otherwise If llm_reply.starts_with("NEWS:") then
            Create topic equal to llm_reply.replace("NEWS:", "").trim()
            Create n_result equal to tool_news(topic)
            messages.add(Map with role = "assistant" and content = llm_reply)
            messages.add(Map with role = "system" and content = "News: " + n_result)

        Otherwise If llm_reply.starts_with("REMEMBER:") then
            Create fact equal to llm_reply.replace("REMEMBER:", "").trim()
            memory_save_fact(db, user_id, fact)
            messages.add(Map with role = "assistant" and content = llm_reply)
            messages.add(Map with role = "system" and content = "Fact saved.")

        Otherwise If llm_reply.starts_with("LEARN:") then
            Create learn_data equal to llm_reply.replace("LEARN:", "").trim()
            Create parts equal to learn_data.split("|")
            If length(parts) == 2 then
                memory_save_knowledge(db, parts[0].trim(), parts[1].trim())
                messages.add(Map with role = "assistant" and content = llm_reply)
                messages.add(Map with role = "system" and content = "Knowledge saved.")
            End

        Otherwise If llm_reply.starts_with("GENERATE_IMAGE:") then
            Create prompt equal to llm_reply.replace("GENERATE_IMAGE:", "").trim()
            Create img_url equal to tool_generate_image(prompt)
            messages.add(Map with role = "assistant" and content = llm_reply)
            messages.add(Map with role = "system" and content = "Image URL: " + img_url + " (include this in your response)")

        Otherwise If llm_reply.starts_with("CREATE_ROLE:") then
            If username is not equal to "abneesh.dev" then
                messages.add(Map with role = "system" and content = "ERROR: Founder-only command.")
                Continue
            End
            Create role_data equal to llm_reply.replace("CREATE_ROLE:", "").trim()
            Create parts equal to role_data.split("|")
            If length(parts) >= 2 then
                Create result equal to tool_create_role(guild_id, token, parts[0].trim(), parts[1].trim(), "0")
                messages.add(Map with role = "assistant" and content = llm_reply)
                messages.add(Map with role = "system" and content = result)
            End

        Otherwise If llm_reply.starts_with("CREATE_CHANNEL:") then
            If username is not equal to "abneesh.dev" then
                messages.add(Map with role = "system" and content = "ERROR: Founder-only command.")
                Continue
            End
            Create ch_data equal to llm_reply.replace("CREATE_CHANNEL:", "").trim()
            Create parts equal to ch_data.split("|")
            If length(parts) >= 2 then
                Create result equal to tool_create_channel(guild_id, token, parts[0].trim(), parts[1].trim())
                messages.add(Map with role = "assistant" and content = llm_reply)
                messages.add(Map with role = "system" and content = result)
            End

        Otherwise If llm_reply.starts_with("SCAN_SERVER:") then
            Create result equal to tool_scan_server(guild_id, token)
            messages.add(Map with role = "assistant" and content = llm_reply)
            messages.add(Map with role = "system" and content = "Server: " + result)

        Otherwise If llm_reply.starts_with("BROADCAST:") then
            If username is not equal to "abneesh.dev" and is_autonomous is not equal to True then
                messages.add(Map with role = "system" and content = "ERROR: Founder/autonomous only.")
                Continue
            End
            Create b_data equal to llm_reply.replace("BROADCAST:", "").trim()
            Create parts equal to b_data.split("|")
            If length(parts) >= 2 then
                Create result equal to tool_broadcast(parts[0].trim(), token, parts[1].trim())
                messages.add(Map with role = "assistant" and content = llm_reply)
                messages.add(Map with role = "system" and content = result)
            End

        Otherwise If llm_reply.starts_with("CHECK_GITHUB:") then
            Create result equal to tool_check_github("trigger")
            messages.add(Map with role = "assistant" and content = llm_reply)
            messages.add(Map with role = "system" and content = result)

        Otherwise
            memory_save_message(db, user_id, username, "user", user_message)
            memory_save_message(db, user_id, username, "assistant", llm_reply)
            Return llm_reply
        End
    End

    Return "Processing limit reached. Please try again."
End
