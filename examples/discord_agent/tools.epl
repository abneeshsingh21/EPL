Function tool_assign_role takes guild_id, token, user_id, role_id
    Create url equal to "https://discord.com/api/v10/guilds/" + guild_id + "/members/" + user_id + "/roles/" + role_id
    Create headers equal to dict_from_lists(["Authorization", "Content-Type"], ["Bot " + token, "application/json"])
    Create response equal to http_put(url, "{}", headers)
    If response.status >= 200 and response.status < 300 then
        Return "Role assigned successfully to user " + user_id
    Else
        Return "Failed to assign role. Error: " + response.body
    End
End

Function tool_delete_message takes channel_id, message_id, token
    Create url equal to "https://discord.com/api/v10/channels/" + channel_id + "/messages/" + message_id
    Create headers equal to dict_from_lists(["Authorization"], ["Bot " + token])
    Create response equal to http_delete(url, headers)
    If response.status >= 200 and response.status < 300 then
        Return "Message deleted successfully."
    Else
        Return "Failed to delete message. Error: " + response.body
    End
End

Function tool_timeout_user takes guild_id, token, user_id, duration_seconds
    Create url equal to "https://discord.com/api/v10/guilds/" + guild_id + "/members/" + user_id
    Create headers equal to dict_from_lists(["Authorization", "Content-Type"], ["Bot " + token, "application/json"])
    Note: Calculate ISO timestamp for timeout expiry
    Create body equal to json_stringify(Map with communication_disabled_until = "2099-01-01T00:00:00Z")
    If duration_seconds is equal to 0 then
        Set body to json_stringify(Map with communication_disabled_until = Nothing)
    End
    Create response equal to http_patch(url, body, headers)
    If response.status >= 200 and response.status < 300 then
        Return "User timed out successfully."
    Else
        Return "Failed to timeout user. Error: " + response.body
    End
End

Function tool_send_welcome takes channel_id, token, username, user_id
    Create url equal to "https://discord.com/api/v10/channels/" + channel_id + "/messages"
    
    Create welcome_msg equal to "# 👋 Welcome to the EPL Community, **" + username + "**!\n\n"
    Set welcome_msg to welcome_msg + "We're thrilled to have you here! 🎉\n\n"
    Set welcome_msg to welcome_msg + "**EPL (English Programming Language)** lets you write code using natural English — no cryptic syntax needed.\n\n"
    Set welcome_msg to welcome_msg + "```\nCreate message equal to " + "\x22" + "Hello, " + username + "!" + "\x22" + "\nSay message\n```\n\n"
    Set welcome_msg to welcome_msg + "🚀 **Quick Start:**\n"
    Set welcome_msg to welcome_msg + "• `pip install eplang` → Install EPL\n"
    Set welcome_msg to welcome_msg + "• `epl repl` → Try it interactively\n"
    Set welcome_msg to welcome_msg + "• `epl run hello.epl` → Run your first program\n\n"
    Set welcome_msg to welcome_msg + "📚 **Explore:**\n"
    Set welcome_msg to welcome_msg + "• <#1507812500769603604> → Getting Started guide\n"
    Set welcome_msg to welcome_msg + "• <#1507811866154635344> → Ask me anything about EPL\n"
    Set welcome_msg to welcome_msg + "• <#1507813223406112890> → Get help from the community\n"
    Set welcome_msg to welcome_msg + "• <#1507812597431402707> → Chat with the community\n\n"
    Set welcome_msg to welcome_msg + "I'm **EPLAI**, the AI assistant here. Mention me or visit <#1507811866154635344> and I'll help you learn EPL! 🤖"

    Create embed equal to Map with description = welcome_msg and color = 3066993
    Create embeds_arr equal to []
    embeds_arr.add(embed)
    Create body equal to json_stringify(Map with content = "<@" + user_id + ">" and embeds = embeds_arr)
    Create headers equal to dict_from_lists(["Authorization", "Content-Type"], ["Bot " + token, "application/json"])
    Create response equal to http_post(url, body, headers)
    If response.status >= 200 and response.status < 300 then
        Return "Welcome message sent for " + username
    Else
        Return "Failed to send welcome. Error: " + response.body
    End
End

Function tool_get_server_member_count takes guild_id, token
    Create url equal to "https://discord.com/api/v10/guilds/" + guild_id + "?with_counts=true"
    Create headers equal to dict_from_lists(["Authorization"], ["Bot " + token])
    Create response equal to http_get(url, headers)
    If response.status >= 200 and response.status < 300 then
        Create data equal to response.body
        Return data["approximate_member_count"]
    Else
        Return 0
    End
End
