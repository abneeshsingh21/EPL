Function tool_web_search takes query
    Create url equal to "https://api.duckduckgo.com/?q=" + url_encode(query) + "&format=json"
    Create response equal to http_get(url)

    If response.status is not equal to 200 then
        Return "Search failed: " + response.body
    End

    Create data equal to response.body
    Create result equal to data["AbstractText"]

    If result is equal to "" then
        Create related equal to data["RelatedTopics"]
        If length(related) > 0 then
            Create first_topic equal to related[0]
            If first_topic["Text"] is not equal to Nothing then
                Set result to first_topic["Text"]
            End
        End
    End

    If result is equal to "" then
        Return "No useful information found for: " + query
    End

    Return result
End

Function tool_weather takes location
    Create url equal to "https://wttr.in/" + url_encode(location) + "?format=j1"
    Create response equal to http_get(url)
    If response.status is not equal to 200 then
        Return "Could not fetch weather for " + location
    End
    Create data equal to response.body
    Create current equal to data["current_condition"][0]
    Return "Weather in " + location + ": " + current["temp_C"] + "C, " + current["weatherDesc"][0]["value"] + "."
End

Function tool_calculate takes expression
    Create url equal to "http://api.mathjs.org/v4/?expr=" + url_encode(expression)
    Create response equal to http_get(url)
    If response.status is not equal to 200 then
        Return "Calculation failed: " + response.body
    End
    Return "Result of " + expression + " = " + response.body
End

Function tool_news takes topic
    Return tool_web_search(topic + " latest breaking news")
End

Function tool_generate_image takes prompt
    Create prompt_encoded equal to url_encode(prompt)
    Create url equal to "https://image.pollinations.ai/prompt/" + prompt_encoded + "?width=1920&height=1080&nologo=true"
    Return url
End

Function tool_create_role takes guild_id, token, role_name, color_hex, permissions
    Create url equal to "https://discord.com/api/v10/guilds/" + guild_id + "/roles"
    Create body equal to json_stringify(Map with name = role_name and permissions = permissions)
    Create headers equal to dict_from_lists(["Authorization", "Content-Type"], ["Bot " + token, "application/json"])
    Create response equal to http_post(url, body, headers)
    If response.status >= 200 and response.status < 300 then
        Return "Role '" + role_name + "' created successfully."
    Else
        Return "Failed to create role. Error: " + response.body
    End
End

Function tool_create_channel takes guild_id, token, channel_name, type
    Create url equal to "https://discord.com/api/v10/guilds/" + guild_id + "/channels"
    Create type_int equal to int(type)
    Create body equal to json_stringify(Map with name = channel_name and type = type_int)
    Create headers equal to dict_from_lists(["Authorization", "Content-Type"], ["Bot " + token, "application/json"])
    Create response equal to http_post(url, body, headers)
    If response.status >= 200 and response.status < 300 then
        Return "Channel '" + channel_name + "' created successfully."
    Else
        Return "Failed to create channel. Error: " + response.body
    End
End
