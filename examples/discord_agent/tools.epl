Function tool_web_search takes query
    Create url equal to "https://api.duckduckgo.com/?q=" + url_encode(query) + "&format=json"
    Create response equal to http_get(url)

    If response.status is not equal to 200 then
        Return "Search failed: " + response.body
    End

    Create data equal to response.body
    Create result equal to data["AbstractText"]

    If result is equal to "" then
        Create related equal to data["RelatedTopics"]
        If length(related) > 0 then
            Create first_topic equal to related[0]
            If first_topic["Text"] is not equal to Nothing then
                Set result to first_topic["Text"]
            End
        End
    End

    If result is equal to "" then
        Return "No useful information found for: " + query
    End

    Return result
End

Function tool_weather takes location
    Create url equal to "https://wttr.in/" + url_encode(location) + "?format=j1"
    Create response equal to http_get(url)
    If response.status is not equal to 200 then
        Return "Could not fetch weather for " + location
    End
    Create data equal to response.body
    Create current equal to data["current_condition"][0]
    Return "Weather in " + location + ": " + current["temp_C"] + "C, " + current["weatherDesc"][0]["value"] + "."
End

Function tool_calculate takes expression
    Create url equal to "http://api.mathjs.org/v4/?expr=" + url_encode(expression)
    Create response equal to http_get(url)
    If response.status is not equal to 200 then
        Return "Calculation failed: " + response.body
    End
    Return "Result of " + expression + " = " + response.body
End

Function tool_news takes topic
    Return tool_web_search(topic + " latest breaking news")
End
