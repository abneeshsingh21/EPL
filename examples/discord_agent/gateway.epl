Create WS_URL equal to "https://gateway.discord.gg/?v=10&encoding=json"
Create WS_URL equal to "wss://gateway.discord.gg/?v=10&encoding=json"

Note: ═══════════════════════════════════════════════════════════════
Note: ANTI-RAID — Detect mass joins
Note: ═══════════════════════════════════════════════════════════════

Create RECENT_JOINS equal to []
Create RAID_THRESHOLD equal to 10
Create RAID_WINDOW equal to 60

Function check_raid takes ws_map, username
    Create now equal to time_now()
    RECENT_JOINS.add(now)
    
    Note: Remove joins older than RAID_WINDOW seconds
    Create filtered equal to []
    For Each join_time in RECENT_JOINS
        If now - join_time < RAID_WINDOW then
            filtered.add(join_time)
        End
    End
    Set RECENT_JOINS to filtered
    
    If length(RECENT_JOINS) >= RAID_THRESHOLD then
        Say "[RAID] ⚠️ RAID DETECTED! " + length(RECENT_JOINS) + " joins in 60 seconds!"
        Note: Alert founder in #bot-control
        Create alert_msg equal to "🚨 **RAID ALERT!** 🚨\n\n**" + length(RECENT_JOINS) + " users joined in under 60 seconds!**\n\nRecommend: Enable verification level or lock invites.\nLast join: **" + username + "**"
        Create embed equal to Map with description = alert_msg and color = 15158332
        Create embeds_arr equal to []
        embeds_arr.add(embed)
        Create body equal to json_stringify(Map with embeds = embeds_arr)
        db_execute(ws_map["db"], "INSERT INTO outbound_queue (channel_id, payload, token) VALUES (?, ?, ?)", ["1507898202693570751", body, ws_map["token"]])
        Return True
    End
    Return False
End

Note: ═══════════════════════════════════════════════════════════════
Note: AUTO-MODERATION
Note: ═══════════════════════════════════════════════════════════════

Function gateway_auto_moderate takes ws_map, d, content, username, user_id, channel_id
    If username is equal to "abneesh.dev" then
        Return False
    End

    Create is_spam equal to False
    Create reason equal to ""

    If content.contains("discord.gg/") or content.contains("discordapp.com/invite") then
        Set is_spam to True
        Set reason to "Unauthorized invite link"
    End
    If content.contains("@everyone") or content.contains("@here") then
        Set is_spam to True
        Set reason to "Unauthorized mass mention"
    End

    If is_spam is equal to True then
        Say "[AutoMod] SPAM from " + username + ": " + reason
        Create message_id equal to d["id"]
        tool_delete_message(channel_id, message_id, ws_map["token"])
        memory_log_moderation(ws_map["db"], user_id, username, "auto_delete", reason)
        
        Create warn_msg equal to "⚠️ Message from **" + username + "** removed: " + reason
        Create embed equal to Map with description = warn_msg and color = 15105570
        Create embeds_arr equal to []
        embeds_arr.add(embed)
        Create body equal to json_stringify(Map with embeds = embeds_arr)
        db_execute(ws_map["db"], "INSERT INTO outbound_queue (channel_id, payload, token) VALUES (?, ?, ?)", [channel_id, body, ws_map["token"]])
        Return True
    End
    Return False
End

Note: ═══════════════════════════════════════════════════════════════
Note: XP / LEVELING SYSTEM
Note: ═══════════════════════════════════════════════════════════════

Function award_xp takes db, user_id, username, channel_id, token
    Note: Award 5-15 XP per message (not spam channels)
    Create xp_gain equal to 10
    
    Create rows equal to db_query(db, "SELECT xp, level FROM xp_levels WHERE user_id = ?", [user_id])
    Create current_xp equal to 0
    Create current_level equal to 0
    If length(rows) > 0 then
        Set current_xp to rows[0]["xp"]
        Set current_level to rows[0]["level"]
    End
    
    Create new_xp equal to current_xp + xp_gain
    
    Note: Level thresholds: L1=100, L2=300, L3=600, L4=1000, L5=2000, L6=5000
    Create new_level equal to 0
    If new_xp >= 5000 then
        Set new_level to 6
    Otherwise If new_xp >= 2000 then
        Set new_level to 5
    Otherwise If new_xp >= 1000 then
        Set new_level to 4
    Otherwise If new_xp >= 600 then
        Set new_level to 3
    Otherwise If new_xp >= 300 then
        Set new_level to 2
    Otherwise If new_xp >= 100 then
        Set new_level to 1
    End
    
    db_execute(db, "INSERT INTO xp_levels (user_id, username, xp, level) VALUES (?, ?, ?, ?) ON CONFLICT(user_id) DO UPDATE SET xp=?, level=?, username=?", [user_id, username, new_xp, new_level, new_xp, new_level, username])
    
    Note: Level up announcement
    If new_level > current_level and new_level > 0 then
        Create level_names equal to ["Newcomer", "Beginner", "Intermediate", "Advanced", "Expert", "EPL Master", "EPL Legend"]
        Create level_name equal to level_names[new_level]
        Create level_msg equal to "🎉 **Level Up!** <@" + user_id + "> reached **Level " + new_level + " — " + level_name + "**! (" + new_xp + " XP)"
        Create embed equal to Map with description = level_msg and color = 16766720
        Create embeds_arr equal to []
        embeds_arr.add(embed)
        Create body equal to json_stringify(Map with embeds = embeds_arr)
        db_execute(db, "INSERT INTO outbound_queue (channel_id, payload, token) VALUES (?, ?, ?)", [channel_id, body, token])
        Say "[XP] " + username + " leveled up to " + new_level + "!"
    End
End

Note: ═══════════════════════════════════════════════════════════════
Note: AUTO-WELCOME
Note: ═══════════════════════════════════════════════════════════════

Function gateway_handle_member_join takes ws_map, d
    Create user equal to d["user"]
    Create username equal to user["username"]
    Create user_id equal to user["id"]
    Create guild_id equal to d["guild_id"]

    Say "[Welcome] 🎉 New member: " + username
    memory_log_member_event(ws_map["db"], user_id, username, "join")
    
    Note: Check for raid
    check_raid(ws_map, username)
    
    Note: Send welcome
    Create welcome_channel equal to "1507812301527318688"
    tool_send_welcome(welcome_channel, ws_map["token"], username, user_id)
    
    Note: Auto-role
    Create auto_role_id equal to env_get("AUTO_ROLE_ID")
    If auto_role_id is not equal to "" then
        tool_assign_role(guild_id, ws_map["token"], user_id, auto_role_id)
    End

    Note: Initialize XP
    db_execute(ws_map["db"], "INSERT INTO xp_levels (user_id, username, xp, level) VALUES (?, ?, 0, 0) ON CONFLICT(user_id) DO NOTHING", [user_id, username])

    Note: Milestone check
    Create member_count equal to tool_get_server_member_count(guild_id, ws_map["token"])
    If member_count is not equal to 0 then
        Create is_milestone equal to False
        If member_count is equal to 10 or member_count is equal to 25 or member_count is equal to 50 or member_count is equal to 100 or member_count is equal to 250 or member_count is equal to 500 or member_count is equal to 1000 then
            Set is_milestone to True
        End
        If is_milestone is equal to True then
            Create m_msg equal to "🎊 **MILESTONE!** The EPL Community has reached **" + member_count + " members**! 🚀"
            Create embed equal to Map with description = m_msg and color = 16766720
            Create embeds_arr equal to []
            embeds_arr.add(embed)
            Create body equal to json_stringify(Map with embeds = embeds_arr)
            db_execute(ws_map["db"], "INSERT INTO outbound_queue (channel_id, payload, token) VALUES (?, ?, ?)", ["1507812597431402707", body, ws_map["token"]])
        End
    End
End

Function gateway_handle_member_leave takes ws_map, d
    Create user equal to d["user"]
    Say "[Leave] 👋 " + user["username"] + " left."
    memory_log_member_event(ws_map["db"], user["id"], user["username"], "leave")
End

Note: ═══════════════════════════════════════════════════════════════
Note: TICKET SYSTEM — !ticket command
Note: ═══════════════════════════════════════════════════════════════

Function handle_ticket_command takes ws_map, d, username, user_id, channel_id, content
    If content.starts_with("!ticket") then
        Create reason equal to content.replace("!ticket", "").trim()
        If reason is equal to "" then
            Set reason to "No reason provided"
        End
        
        Say "[Ticket] Creating ticket for " + username
        
        Note: Log ticket
        db_execute(ws_map["db"], "INSERT INTO tickets (user_id, username, reason, status) VALUES (?, ?, ?, ?)", [user_id, username, reason, "open"])
        
        Note: Get ticket ID
        Create rows equal to db_query(ws_map["db"], "SELECT id FROM tickets WHERE user_id = ? ORDER BY id DESC LIMIT 1", [user_id])
        Create ticket_id equal to "?"
        If length(rows) > 0 then
            Set ticket_id to "" + rows[0]["id"]
        End
        
        Create ticket_msg equal to "🎫 **Ticket #" + ticket_id + " Created**\n\n**User:** " + username + "\n**Reason:** " + reason + "\n\nA team member will assist you soon. In the meantime, please describe your issue in detail here."
        Create embed equal to Map with description = ticket_msg and color = 3447003
        Create embeds_arr equal to []
        embeds_arr.add(embed)
        Create body equal to json_stringify(Map with embeds = embeds_arr)
        db_execute(ws_map["db"], "INSERT INTO outbound_queue (channel_id, payload, token) VALUES (?, ?, ?)", [channel_id, body, ws_map["token"]])
        
        Note: Notify bot-control
        Create notify_msg equal to "📋 **New Ticket #" + ticket_id + "** from **" + username + "**: " + reason
        Create n_embed equal to Map with description = notify_msg and color = 15105570
        Create n_embeds equal to []
        n_embeds.add(n_embed)
        Create n_body equal to json_stringify(Map with embeds = n_embeds)
        db_execute(ws_map["db"], "INSERT INTO outbound_queue (channel_id, payload, token) VALUES (?, ?, ?)", ["1507898202693570751", n_body, ws_map["token"]])
        
        Return True
    End
    
    If content.starts_with("!leaderboard") or content.starts_with("!xp") or content.starts_with("!rank") then
        Say "[XP] Leaderboard requested by " + username
        Create rows equal to db_query(ws_map["db"], "SELECT username, xp, level FROM xp_levels ORDER BY xp DESC LIMIT 10")
        Create board equal to "🏆 **EPL Community Leaderboard**\n\n"
        Create rank equal to 1
        Create level_names equal to ["Newcomer", "Beginner", "Intermediate", "Advanced", "Expert", "EPL Master", "EPL Legend"]
        For Each row in rows
            Create medal equal to ""
            If rank is equal to 1 then
                Set medal to "🥇"
            Otherwise If rank is equal to 2 then
                Set medal to "🥈"
            Otherwise If rank is equal to 3 then
                Set medal to "🥉"
            Otherwise
                Set medal to "" + rank + "."
            End
            Create lname equal to level_names[row["level"]]
            Set board to board + medal + " **" + row["username"] + "** — Level " + row["level"] + " (" + lname + ") — " + row["xp"] + " XP\n"
            Set rank to rank + 1
        End
        
        If length(rows) is equal to 0 then
            Set board to board + "No data yet. Start chatting to earn XP!"
        End
        
        Create embed equal to Map with description = board and color = 16766720
        Create embeds_arr equal to []
        embeds_arr.add(embed)
        Create body equal to json_stringify(Map with embeds = embeds_arr)
        db_execute(ws_map["db"], "INSERT INTO outbound_queue (channel_id, payload, token) VALUES (?, ?, ?)", [channel_id, body, ws_map["token"]])
        Return True
    End

    Return False
End

Note: ═══════════════════════════════════════════════════════════════
Note: MESSAGE HANDLER
Note: ═══════════════════════════════════════════════════════════════

Function gateway_handle_message takes ws_map, d
    Create author equal to d["author"]
    Create bot_id equal to ws_map["bot_id"]
    
    If author["id"] is not equal to bot_id then
        Create content equal to d["content"]
        Create username equal to author["username"]
        Create user_id equal to author["id"]
        Create channel_id equal to d["channel_id"]

        Note: Auto-mod first
        Create was_moderated equal to gateway_auto_moderate(ws_map, d, content, username, user_id, channel_id)
        If was_moderated is equal to True then
            Return Nothing
        End

        Note: Award XP for every message
        award_xp(ws_map["db"], user_id, username, channel_id, ws_map["token"])

        Note: Check for commands (!ticket, !leaderboard, !xp, !rank)
        Create was_command equal to handle_ticket_command(ws_map, d, username, user_id, channel_id, content)
        If was_command is equal to True then
            Return Nothing
        End

        Say "[Message] #" + channel_id + " " + username + ": " + content
        
        db_execute(ws_map["db"], "INSERT INTO active_channels (channel_id) VALUES (?) ON CONFLICT(channel_id) DO UPDATE SET timestamp=CURRENT_TIMESTAMP", [channel_id])

        Create image_url equal to ""
        Create attachments equal to d["attachments"]
        If attachments is not equal to Nothing then
            If length(attachments) > 0 then
                Set image_url to attachments[0]["url"]
            End
        End

        Create guild_id equal to d["guild_id"]
        Create reply equal to agent_process(ws_map["db"], user_id, username, content, ws_map["groq_api_key"], image_url, guild_id, ws_map["token"], channel_id)
        
        Note: IGNORE check
        Create trimmed equal to reply.trim()
        Create should_ignore equal to False
        If trimmed is equal to "IGNORE" or trimmed.starts_with("IGNORE") then
            Set should_ignore to True
        End
        If trimmed.contains("IGNORE") and length(trimmed) < 500 then
            Set should_ignore to True
        End

        If should_ignore is not equal to True then
            Create embed equal to Map with description = reply and color = 3447003
            Create embeds_arr equal to []
            embeds_arr.add(embed)
            Create body equal to json_stringify(Map with embeds = embeds_arr)
            db_execute(ws_map["db"], "INSERT INTO outbound_queue (channel_id, payload, token) VALUES (?, ?, ?)", [channel_id, body, ws_map["token"]])
            Say "[Agent] Queued reply."
        Else
            Say "[Agent] Ignored."
        End
    End
End

Note: ═══════════════════════════════════════════════════════════════
Note: OUTBOUND WORKER
Note: ═══════════════════════════════════════════════════════════════

Function gateway_outbound_worker takes ws_map
    Say "[OutboundWorker] Started."
    While True
        Create rows equal to db_query(ws_map["db"], "SELECT id, channel_id, payload, token FROM outbound_queue ORDER BY id ASC LIMIT 1")
        If length(rows) > 0 then
            Create row equal to rows[0]
            Create post_url equal to "https://discord.com/api/v10/channels/" + row["channel_id"] + "/messages"
            Create headers equal to dict_from_lists(["Authorization", "Content-Type"], ["Bot " + row["token"], "application/json"])
            http_post(post_url, row["payload"], headers)
            db_execute(ws_map["db"], "DELETE FROM outbound_queue WHERE id = ?", [row["id"]])
            real_sleep(1.5)
        Else
            real_sleep(0.5)
        End
    End
End

Note: ═══════════════════════════════════════════════════════════════
Note: GATEWAY CORE
Note: ═══════════════════════════════════════════════════════════════

Create GLOBAL_SEQ equal to 0

Function gateway_send takes ws, op, d
    Create payload equal to Map with op = op and d = d
    net_ws_send(ws, json_stringify(payload))
End

Function gateway_identify takes ws, token
    Say "[Gateway] Identifying..."
    Create props equal to Map with os = "windows" and browser = "epl_bot" and device = "epl_bot"
    Note: Intents: GUILD_MEMBERS(2) + GUILD_MESSAGES(512) + DIRECT_MESSAGES(4096) + MESSAGE_CONTENT(32768) + GUILD_MESSAGE_REACTIONS(1024) = 38402
    Create d equal to Map with token = token and intents = 38402 and properties = props
    gateway_send(ws, 2, d)
End

Function gateway_heartbeat_worker takes ws, interval
    Create sleep_sec equal to interval / 1000
    While True
        sleep(sleep_sec)
        Create seq equal to GLOBAL_SEQ
        If seq is equal to 0 then
            Set seq to Nothing
        End
        gateway_send(ws, 1, seq)
    End
End

Function gateway_heartbeat_loop takes ws_map
    Create pool equal to real_thread_pool_create(2)

    While True
        Create msg equal to net_ws_receive(ws_map["ws"])
        If msg is equal to Nothing or msg is equal to "" then
            Continue
        End
        
        Create payload equal to json_parse(msg)
        Create op equal to payload["op"]
        
        If payload["s"] is not equal to Nothing then
            Set GLOBAL_SEQ to payload["s"]
        End

        If op is equal to 10 then
            Create d equal to payload["d"]
            Create interval equal to d["heartbeat_interval"]
            Say "[Gateway] HELLO. Heartbeat: " + interval + "ms"
            Set ws_map to ws_map.merge(Map with interval = interval)
            real_thread_pool_submit(pool, gateway_heartbeat_worker, ws_map["ws"], interval)
            gateway_identify(ws_map["ws"], ws_map["token"])
        End

        If op is equal to 0 then
            Create t equal to payload["t"]
            Create d equal to payload["d"]
            
            If t is equal to "READY" then
                Create user equal to d["user"]
                Say "[Gateway] ✅ Logged in as: " + user["username"]
                Set ws_map to ws_map.merge(Map with bot_id = user["id"])
            End
            
            If t is equal to "MESSAGE_CREATE" then
                thread_run(gateway_handle_message, [ws_map, d])
            End
            If t is equal to "GUILD_MEMBER_ADD" then
                thread_run(gateway_handle_member_join, [ws_map, d])
            End
            If t is equal to "GUILD_MEMBER_REMOVE" then
                thread_run(gateway_handle_member_leave, [ws_map, d])
            End
        End
    End
End

Function gateway_heartbeat_sender takes ws_map
    While True
        Create interval equal to ws_map["interval"]
        If interval is not equal to 0 then
            gateway_send(ws_map["ws"], 1, Nothing)
            Create sec equal to interval / 1000
            real_sleep(sec)
        Else
            real_sleep(1)
        End
    End
End

Note: ═══════════════════════════════════════════════════════════════
Note: AUTONOMOUS LOOP
Note: ═══════════════════════════════════════════════════════════════

Function gateway_autonomous_loop takes ws_map
    real_sleep(60)
    Say "[Autonomous] Loop started (24h cycle)."

    While True
        Say "[Autonomous] ═══ Running cycle ═══"
        Create reply equal to agent_process(ws_map["db"], "SYSTEM", "SYSTEM_AUTONOMOUS", "[Autonomous trigger] Check GitHub for new EPL commits. Announce updates to #announcements via BROADCAST. Post an EPL tip to #general via BROADCAST. Execute ALL steps.", ws_map["groq_api_key"], "", "", ws_map["token"], "autonomous")
        Say "[Autonomous] Done: " + reply
        real_sleep(86400)
    End
End

Note: ═══════════════════════════════════════════════════════════════
Note: MAIN ENTRY
Note: ═══════════════════════════════════════════════════════════════

Function gateway_run takes db, token, groq_api_key
    Say "[Bot] Connecting to Discord Gateway..."
    Create ws equal to net_ws_connect(WS_URL)
    Say "[Gateway] Connected!"
    
    Create ws_map equal to Map with ws = ws and token = token and groq_api_key = groq_api_key and db = db and interval = 0 and bot_id = ""
    
    thread_run(gateway_heartbeat_sender, [ws_map])
    thread_run(gateway_autonomous_loop, [ws_map])
    thread_run(gateway_outbound_worker, [ws_map])
    gateway_heartbeat_loop(ws_map)
End
