Function memory_setup takes db
    db_execute(db, "PRAGMA journal_mode=WAL;")
    db_execute(db, "PRAGMA synchronous=NORMAL;")
    db_execute(db, "CREATE TABLE IF NOT EXISTS outbound_queue (id INTEGER PRIMARY KEY AUTOINCREMENT, channel_id TEXT NOT NULL, payload TEXT NOT NULL, token TEXT NOT NULL)")
    db_execute(db, "CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id TEXT NOT NULL, username TEXT NOT NULL, role TEXT NOT NULL, content TEXT NOT NULL, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)")
    db_execute(db, "CREATE TABLE IF NOT EXISTS facts (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id TEXT NOT NULL, fact TEXT NOT NULL, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)")
    db_execute(db, "CREATE TABLE IF NOT EXISTS knowledge (id INTEGER PRIMARY KEY AUTOINCREMENT, topic TEXT UNIQUE NOT NULL, content TEXT NOT NULL, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)")
    db_execute(db, "CREATE TABLE IF NOT EXISTS active_channels (id INTEGER PRIMARY KEY AUTOINCREMENT, channel_id TEXT UNIQUE NOT NULL, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)")
    db_execute(db, "CREATE TABLE IF NOT EXISTS user_profiles (user_id TEXT UNIQUE NOT NULL, profile TEXT NOT NULL, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)")

    Note: ═══ NEW: Member tracking table ═══
    db_execute(db, "CREATE TABLE IF NOT EXISTS member_events (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id TEXT NOT NULL, username TEXT NOT NULL, event_type TEXT NOT NULL, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)")

    Note: ═══ NEW: Moderation log table ═══
    db_execute(db, "CREATE TABLE IF NOT EXISTS moderation_log (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id TEXT NOT NULL, username TEXT NOT NULL, action TEXT NOT NULL, reason TEXT NOT NULL, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)")

    Note: ═══ NEW: Server stats table ═══
    db_execute(db, "CREATE TABLE IF NOT EXISTS server_stats (key TEXT UNIQUE NOT NULL, value TEXT NOT NULL, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP)")
End

Function memory_save_message takes db, user_id, username, role, content
    db_execute(db, "INSERT INTO messages (user_id, username, role, content) VALUES (?, ?, ?, ?)", [user_id, username, role, content])
End

Function memory_get_history takes db, user_id
    Create rows equal to db_query(db, "SELECT role, content FROM messages WHERE user_id = ? ORDER BY timestamp DESC LIMIT 20", [user_id])
    Create history equal to []
    For Each row in rows
        history.add(Map with role = row["role"] and content = row["content"])
    End
    history.reverse()
    Return history
End

Function memory_save_fact takes db, user_id, fact
    db_execute(db, "INSERT INTO facts (user_id, fact) VALUES (?, ?)", [user_id, fact])
End

Function memory_get_facts takes db, user_id
    Create rows equal to db_query(db, "SELECT fact FROM facts WHERE user_id = ? ORDER BY timestamp ASC", [user_id])
    Create facts equal to []
    For Each row in rows
        facts.add(row["fact"])
    End
    Return facts
End

Function memory_save_knowledge takes db, topic, content
    db_execute(db, "INSERT INTO knowledge (topic, content) VALUES (?, ?) ON CONFLICT(topic) DO UPDATE SET content=excluded.content", [topic, content])
End

Function memory_get_knowledge takes db, topic
    Create rows equal to db_query(db, "SELECT content FROM knowledge WHERE topic = ?", [topic])
    If length(rows) > 0 then
        Return rows[0]["content"]
    End
    Return Nothing
End

Function memory_get_profile takes db, user_id
    Create rows equal to db_query(db, "SELECT profile FROM user_profiles WHERE user_id = ?", [user_id])
    If length(rows) > 0 then
        Return rows[0]["profile"]
    End
    Return ""
End

Function memory_save_profile takes db, user_id, profile
    db_execute(db, "INSERT INTO user_profiles (user_id, profile) VALUES (?, ?) ON CONFLICT(user_id) DO UPDATE SET profile=excluded.profile", [user_id, profile])
End

Note: ═══ NEW: Member event tracking ═══

Function memory_log_member_event takes db, user_id, username, event_type
    db_execute(db, "INSERT INTO member_events (user_id, username, event_type) VALUES (?, ?, ?)", [user_id, username, event_type])
End

Function memory_get_member_count takes db
    Create rows equal to db_query(db, "SELECT COUNT(DISTINCT user_id) as cnt FROM member_events WHERE event_type = 'join'")
    If length(rows) > 0 then
        Return rows[0]["cnt"]
    End
    Return 0
End

Note: ═══ NEW: Moderation logging ═══

Function memory_log_moderation takes db, user_id, username, action, reason
    db_execute(db, "INSERT INTO moderation_log (user_id, username, action, reason) VALUES (?, ?, ?, ?)", [user_id, username, action, reason])
End

Note: ═══ NEW: Server stats ═══

Function memory_set_stat takes db, key, value
    db_execute(db, "INSERT INTO server_stats (key, value, updated_at) VALUES (?, ?, CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_at=CURRENT_TIMESTAMP", [key, value])
End

Function memory_get_stat takes db, key
    Create rows equal to db_query(db, "SELECT value FROM server_stats WHERE key = ?", [key])
    If length(rows) > 0 then
        Return rows[0]["value"]
    End
    Return ""
End
