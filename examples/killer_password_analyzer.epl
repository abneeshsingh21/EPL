Note:  EPL Password Strength Analyzer
Note:  A security tool written in readable English
Note: ═══════════════════════════════════════════════════════

Note: === Helper Functions ===

Function check_length takes pwd
    Create len equal to length(pwd)
    If len < 6 then
        Return 0
    Otherwise If len < 8 then
        Return 1
    Otherwise If len < 12 then
        Return 2
    Else
        Return 3
    End
End

Function has_uppercase takes pwd
    Create uppers equal to "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    For each ch in pwd
        If uppers.contains(ch) then
            Return true
        End
    End
    Return false
End

Function has_lowercase takes pwd
    Create lowers equal to "abcdefghijklmnopqrstuvwxyz"
    For each ch in pwd
        If lowers.contains(ch) then
            Return true
        End
    End
    Return false
End

Function has_numbers takes pwd
    Create digits equal to "0123456789"
    For each ch in pwd
        If digits.contains(ch) then
            Return true
        End
    End
    Return false
End

Function has_special takes pwd
    Create specials equal to "!@#$%^&*()-_=+[]{}|;:,.<>?/"
    For each ch in pwd
        If specials.contains(ch) then
            Return true
        End
    End
    Return false
End

Function has_common_pattern takes pwd
    Create pwd_lower equal to pwd.lowercase()
    Create common equal to ["password", "123456", "qwerty", "abc123", "letmein", "admin", "welcome"]
    For each word in common
        If pwd_lower.contains(word) then
            Return word
        End
    End
    Return ""
End

Function analyze_password takes pwd
    Create score equal to check_length(pwd)
    Create feedback equal to []
    
    Note: Length feedback
    Create len equal to length(pwd)
    If len < 6 then
        Add "  [X] Too short (" + len + " chars, need 6+)" to feedback
    Otherwise If len < 8 then
        Add "  [!] Short (" + len + " chars, 8+ recommended)" to feedback
        Increase score by 0
    Otherwise If len < 12 then
        Add "  [OK] Good length (" + len + " chars)" to feedback
    Else
        Add "  [OK] Excellent length (" + len + " chars)" to feedback
    End
    
    Note: Character checks
    If has_uppercase(pwd) then
        Add "  [OK] Has uppercase letters" to feedback
        Increase score by 1
    Else
        Add "  [X] No uppercase letters" to feedback
    End
    
    If has_lowercase(pwd) then
        Add "  [OK] Has lowercase letters" to feedback
        Increase score by 1
    Else
        Add "  [X] No lowercase letters" to feedback
    End
    
    If has_numbers(pwd) then
        Add "  [OK] Has numbers" to feedback
        Increase score by 1
    Else
        Add "  [X] No numbers" to feedback
    End
    
    If has_special(pwd) then
        Add "  [OK] Has special characters" to feedback
        Increase score by 2
    Else
        Add "  [!] No special characters" to feedback
    End
    
    Note: Common pattern check
    Create pattern equal to has_common_pattern(pwd)
    If length(pattern) > 0 then
        Add "  [!!] Contains common pattern: " + pattern to feedback
        Decrease score by 3
    End
    
    Note: Clamp score
    If score < 0 then
        Set score to 0
    End
    If score > 8 then
        Set score to 8
    End
    
    Note: Build visual meter
    Create meter equal to ""
    For i from 1 to score
        Set meter to meter + "#"
    End
    Create empty equal to 8 - score
    For i from 1 to empty
        Set meter to meter + "-"
    End
    
    Note: Strength label
    Create label equal to "VERY WEAK"
    If score is at least 7 then
        Set label to "STRONG"
    Otherwise If score is at least 5 then
        Set label to "MODERATE"
    Otherwise If score is at least 3 then
        Set label to "WEAK"
    End
    
    Note: Mask password for display
    Create pwd_len equal to length(pwd)
    Create masked_pwd equal to pwd
    If pwd_len > 4 then
        Set masked_pwd to pwd[0:2] + "****" + pwd[pwd_len - 2:]
    End
    
    Note: Print the report
    Say "  ----------------------------------"
    Say "  Password: " + masked_pwd
    Say "  Strength: [" + meter + "] " + score + "/8 - " + label
    Say ""
    For each line in feedback
        Say line
    End
    Say ""
    
    Return score
End

Note: === Main Program ===

Say "============================================================"
Say "         Password Strength Analyzer                         "
Say "============================================================"
Say ""

Create passwords equal to ["password123", "P@ssw0rd!", "alice", "Tr0ub4dor&3", "aB3$xK9!mN2@", "admin"]

Create total_score equal to 0
For each pwd in passwords
    Create result equal to analyze_password(pwd)
    Increase total_score by result
End

Create avg_score equal to round(total_score / length(passwords))

Say "============================================================"
Say "         Summary                                            "
Say "============================================================"
Say ""
Say "  Passwords analyzed: " + length(passwords)
Say "  Average strength:   " + avg_score + "/8"
Say ""
If avg_score < 5 then
    Say "  [WARNING] Overall password hygiene needs improvement!"
Else
    Say "  [OK] Password hygiene is acceptable."
End

Say ""
Say "  Password Best Practices:"
Say "    1. Use at least 12 characters"
Say "    2. Mix uppercase, lowercase, numbers, and symbols"
Say "    3. Avoid dictionary words and common patterns"
Say "    4. Use a unique password for each account"
Say "    5. Consider a passphrase: correct horse battery staple"
Say ""
Say "  Analyzed by EPL Password Strength Analyzer"
Say "============================================================"
