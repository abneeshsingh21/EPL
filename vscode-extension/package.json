{
  "name": "epl-lang",
  "displayName": "EPL — English Programming Language",
  "description": "Embedded HTML/CSS/JS & SQL highlighting, semantic tokens, real-time diagnostics, auto-completions, hover docs, token-aware rename & find-references, and run/check commands for EPL (.epl files)",
  "version": "2.6.0",
  "publisher": "epl-lang",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abneeshsingh21/EPL"
  },
  "homepage": "https://github.com/abneeshsingh21/EPL#readme",
  "bugs": {
    "url": "https://github.com/abneeshsingh21/EPL/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "epl",
    "english",
    "programming language",
    "beginner",
    "natural language",
    "english programming",
    "learn to code",
    "watch mode",
    "diagnostics"
  ],
  "activationEvents": [
    "onLanguage:epl"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "epl",
        "aliases": [
          "EPL",
          "English Programming Language",
          "epl"
        ],
        "extensions": [
          ".epl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./epl_file_icon.svg",
          "dark": "./epl_file_icon.svg"
        }
      },
      {
        "id": "epl-compiled",
        "aliases": ["EPL Compiled"],
        "extensions": [".eplc"],
        "icon": {
          "light": "./epl_compiled_icon.svg",
          "dark": "./epl_compiled_icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "epl",
        "scopeName": "source.epl",
        "path": "./syntaxes/epl.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "epl",
        "scopes": {
          "keyword": ["keyword.control.epl"],
          "variable": ["variable.other.epl"],
          "function": ["entity.name.function.epl"],
          "class": ["entity.name.type.class.epl"],
          "type": ["entity.name.type.epl"],
          "number": ["constant.numeric.epl"],
          "string": ["string.quoted.double.epl"],
          "comment": ["comment.line.epl"],
          "operator": ["keyword.operator.epl"]
        }
      }
    ],
    "configurationDefaults": {
      "[epl]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "snippets": [
      {
        "language": "epl",
        "path": "./snippets/epl.json"
      }
    ],
    "commands": [
      {
        "command": "epl.run",
        "title": "EPL: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "epl.runVM",
        "title": "EPL: Run Current File with Bytecode VM",
        "icon": "$(rocket)"
      },
      {
        "command": "epl.check",
        "title": "EPL: Type Check Current File",
        "icon": "$(check)"
      },
      {
        "command": "epl.format",
        "title": "EPL: Format Current File",
        "icon": "$(edit)"
      },
      {
        "command": "epl.runFile",
        "title": "EPL: Run Current File (Compatibility)"
      },
      {
        "command": "epl.compileFile",
        "title": "EPL: Build Current File",
        "icon": "$(gear)"
      },
      {
        "command": "epl.formatFile",
        "title": "EPL: Format Current File (Compatibility)"
      },
      {
        "command": "epl.lintFile",
        "title": "EPL: Lint Current File",
        "icon": "$(search)"
      },
      {
        "command": "epl.profileFile",
        "title": "EPL: Profile Current File",
        "icon": "$(dashboard)"
      },
      {
        "command": "epl.fixFile",
        "title": "EPL: Fix Errors",
        "icon": "$(zap)"
      },
      {
        "command": "epl.serve",
        "title": "EPL: Serve Current File",
        "icon": "$(server-process)"
      },
      {
        "command": "epl.deploy",
        "title": "EPL: Deploy Current File",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "epl.playground",
        "title": "EPL: Start Playground",
        "icon": "$(browser)"
      },
      {
        "command": "epl.copilot",
        "title": "EPL: Start AI Copilot",
        "icon": "$(hubot)"
      },
      {
        "command": "epl.monitor",
        "title": "EPL: Monitor Endpoint",
        "icon": "$(pulse)"
      },
      {
        "command": "epl.watch",
        "title": "EPL: Watch Current File",
        "icon": "$(eye)"
      },
      {
        "command": "epl.doctor",
        "title": "EPL: Run Doctor (Environment Check)",
        "icon": "$(heart)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "epl.run",
          "when": "editorLangId == epl",
          "group": "navigation"
        },
        {
          "command": "epl.lintFile",
          "when": "editorLangId == epl",
          "group": "navigation@2"
        },
        {
          "command": "epl.fixFile",
          "when": "editorLangId == epl",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "epl.run",
        "key": "ctrl+shift+r",
        "when": "editorLangId == epl"
      },
      {
        "command": "epl.check",
        "key": "ctrl+shift+k",
        "when": "editorLangId == epl"
      }
    ],
    "configuration": {
      "title": "EPL",
      "properties": {
        "epl.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the EPL Language Server for real-time diagnostics and completions"
        },
        "epl.lsp.path": {
          "type": "string",
          "default": "epl",
          "description": "Path to the epl CLI binary (default: 'epl', assumes it's on PATH via pip install eplang)"
        },
        "epl.strictMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable strict type checking (same as epl check --strict)"
        },
        "epl.serve.port": {
          "type": "number",
          "default": 8000,
          "description": "Default port for epl serve"
        },
        "epl.serve.observability": {
          "type": "boolean",
          "default": false,
          "description": "Auto-attach observability endpoints (/_health, /_ready, /_metrics) when serving"
        },
        "epl.watch.timeout": {
          "type": "string",
          "default": "",
          "description": "Per-run timeout for `epl watch` (seconds, or 'none' to disable). Empty = use CLI default (uncapped since v9.0.0)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo ready",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
