{
  "Display": {
    "prefix": "display",
    "body": [
      "Say \"$1\""
    ],
    "description": "Print a line of EPL output"
  },
  "Function": {
    "prefix": "function",
    "body": [
      "Function ${1:name} takes ${2:value}",
      "    $0",
      "End"
    ],
    "description": "Define an EPL function"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "Class ${1:Name}",
      "    $0",
      "End"
    ],
    "description": "Define an EPL class"
  },
  "Constant": {
    "prefix": "const",
    "body": [
      "Constant ${1:NAME} = ${2:value}"
    ],
    "description": "Define an EPL constant"
  },
  "Module": {
    "prefix": "module",
    "body": [
      "Module ${1:Name}",
      "    $0",
      "End"
    ],
    "description": "Define an EPL module"
  },
  "Web App": {
    "prefix": "webapp",
    "body": [
      "Create WebApp called ${1:app}",
      "",
      "Route \"/\" shows",
      "    Page \"${2:Home}\"",
      "        Heading \"${3:Welcome}\"",
      "        Text \"${4:Hello from EPL}\"",
      "    End",
      "End"
    ],
    "description": "Create a basic EPL web app"
  },
  "Test Function": {
    "prefix": "test",
    "body": [
      "Test \"${1:name}\"",
      "    $0",
      "End"
    ],
    "description": "Create an EPL test block"
  },
  "AWS Cloud S3": {
    "prefix": "s3",
    "body": [
      "Import \"epl-cloud\"",
      "",
      "s3_bucket = cloud_s3_bucket(\"${1:bucket-name}\")",
      "cloud_s3_upload(s3_bucket, \"${2:file.txt}\", \"${3:content}\")"
    ],
    "description": "Upload a file to AWS S3"
  },
  "AI Chat": {
    "prefix": "ai",
    "body": [
      "Import \"epl.ai\" As ai",
      "",
      "messages = [Map with role = \"user\" and content = \"${1:prompt}\"]",
      "response = ai.chat(messages)",
      "Say response"
    ],
    "description": "Chat with AI using EPL"
  },
  "JavaScript Bridge": {
    "prefix": "jsbridge",
    "body": [
      "Use javascript \"${1:lodash}\" as ${2:_}",
      "",
      "Say ${2:_}.${3:capitalize}(\"${4:hello epl}\")"
    ],
    "description": "Import an NPM package via JS Bridge"
  },
  "Observability": {
    "prefix": "observability",
    "body": [
      "Create WebApp called ${1:app}",
      "",
      "Import \"epl.observability\" As obs",
      "obs.attach(${1:app})",
      "",
      "Route \"/\" shows",
      "    Page \"${2:Home}\"",
      "        Heading \"${3:My App}\"",
      "        Text \"Health: /_health | Metrics: /_metrics\"",
      "    End",
      "End",
      "",
      "Start ${1:app} on port ${4:8000}"
    ],
    "description": "Web app with health checks and metrics"
  },
  "Deploy K8s": {
    "prefix": "deployk8s",
    "body": [
      "Note: Deploy to Kubernetes:",
      "Note: epl deploy k8s ${TM_FILENAME} --image ${1:myapp}:${2:1.0} --host ${3:app.example.com} --tls"
    ],
    "description": "Kubernetes deployment command"
  },
  "Style Block": {
    "prefix": "style",
    "body": [
      "Style \"${1:card}\"",
      "    background \"${2:#ffffff}\"",
      "    border-radius \"${3:12px}\"",
      "    padding \"${4:24px}\"",
      "End"
    ],
    "description": "Define a CSS style block"
  },
  "3D Scene": {
    "prefix": "scene",
    "body": [
      "Scene \"${1:demo}\" width ${2:800} height ${3:600}",
      "    Mesh \"cube\" position 0, 1, 0 color \"${4:#ff4500}\"",
      "    Light \"ambient\" color \"#ffffff\" intensity 1.0 position 5, 10, 5",
      "    Camera position 0, 5, 10 look_at 0, 0, 0",
      "End"
    ],
    "description": "Create a 3D WebGL scene"
  },
  "Canvas Draw": {
    "prefix": "canvas",
    "body": [
      "Canvas ${1:art} draw ${2:rect} x ${3:10} y ${4:10} width ${5:200} height ${6:100} fill \"${7:#3498db}\""
    ],
    "description": "Draw a shape on a canvas"
  },
  "Health Check Route": {
    "prefix": "health",
    "body": [
      "Route \"/api/health\" responds with",
      "    Send json Map with status = \"ok\" and version = \"${1:1.0.0}\"",
      "End"
    ],
    "description": "Add a JSON health check endpoint"
  },
  "Grid Layout": {
    "prefix": "grid",
    "body": [
      "Grid columns ${1:3} gap \"${2:16px}\"",
      "    Text \"${3:Col 1}\"",
      "    Text \"${4:Col 2}\"",
      "    Text \"${5:Col 3}\"",
      "End"
    ],
    "description": "Create a responsive grid layout"
  }
}
