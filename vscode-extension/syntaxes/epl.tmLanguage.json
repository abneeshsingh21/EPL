{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EPL",
  "scopeName": "source.epl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#triple-strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-web" },
    { "include": "#keywords-gui" },
    { "include": "#keywords-operator" },
    { "include": "#keywords-english-comparison" },
    { "include": "#keywords-builtin" },
    { "include": "#keywords-type" },
    { "include": "#keywords-constant" },
    { "include": "#keywords-modifier" },
    { "include": "#function-def" },
    { "include": "#class-def" },
    { "include": "#function-call" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.epl",
          "begin": "^\\s*NoteBlock\\b",
          "end": "^\\s*End\\b",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.epl" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.epl" } }
        },
        {
          "name": "comment.line.note.epl",
          "match": "^\\s*Note:.*$"
        },
        {
          "name": "comment.line.hash.epl",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.epl",
          "match": "//.*$"
        }
      ]
    },
    "triple-strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.epl",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.epl" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.epl" } }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.epl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.epl",
              "match": "\\\\[nrt\\\\\"']"
            },
            {
              "name": "variable.other.interpolation.epl",
              "match": "\\{[^}]+\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.epl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.epl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.epl",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.epl",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.epl",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.epl",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.epl",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.conditional.epl",
          "match": "\\b(If|Then|Otherwise|Else|Match|When|Default)\\b"
        },
        {
          "name": "keyword.control.loop.epl",
          "match": "\\b(While|For|Each|In|Repeat|Times|From|By|Step)\\b"
        },
        {
          "name": "keyword.control.flow.epl",
          "match": "\\b(Return|Break|Continue|Exit|Yield|Yields|Breakpoint)\\b"
        },
        {
          "name": "keyword.control.exception.epl",
          "match": "\\b(Try|Catch|Finally|Throw|Assert)\\b"
        },
        {
        {
          "name": "keyword.control.async.epl",
          "match": "\\b(Async|Await|Spawn|Parallel|Wait|Seconds)\\b"
        },
        {
          "name": "keyword.control.end.epl",
          "match": "\\bEnd\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.other.declaration.epl",
          "match": "\\b(Set|To|Create|Define|Constant|Remember|Variable|Named|Equal|Declare|Let|Make)\\b"
        },
        {
          "name": "keyword.other.module.epl",
          "match": "\\b(Import|Export|Module|Use|From|Library)\\b"
        },
        {
          "name": "keyword.other.class.epl",
          "match": "\\b(Class|Extends|Implements|Interface|Enum|Generic|Where|Method|has)\\b"
        },
        {
          "name": "storage.type.function.epl",
          "match": "\\b(Function|takes|returns|with|as|and|that|nothing|Lambda|given)\\b"
        }
      ]
    },
    "keywords-web": {
      "patterns": [
        {
          "name": "support.class.web.epl",
          "match": "\\b(WebApp|Route|Page|Start|Heading|SubHeading|Text|Link|Image|Button|Form|Send|Redirect|Store|Fetch|Delete|Script|Json|Port)\\b"
        }
      ]
    },
    "keywords-gui": {
      "patterns": [
        {
          "name": "support.class.gui.epl",
          "match": "\\b(Window|Canvas|Dialog|Layout|Row|Column|Menu|Bind|Label|TextBox|Checkbox|Dropdown|Slider|Progress|TextArea|Tab|Tree|Widget|Scene|Mesh|Light|Camera|Component|Style|Grid|Flex|Responsive|Animate)\\b"
        }
      ]
    },
    "keywords-english-comparison": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.english.epl",
          "match": "\\b(is greater than or equal to|is less than or equal to|is greater than|is less than|is equal to|is not equal to|does not equal|is at least|is at most|is between|raised to|equals|not equals)\\b"
        }
      ]
    },
    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator.logical.epl",
          "match": "\\b(And|Or|Not|Is)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.word.epl",
          "match": "\\b(Plus|Minus|Mod|Increase|Decrease|Multiply|Divide|Add|Sort|Reverse)\\b"
        },
        {
          "name": "keyword.operator.assignment.epl",
          "match": "(\\+=|-=|\\*=|/=|%=|==|!=|>=|<=|\\*\\*|//)"
        },
        {
          "name": "keyword.operator.arrow.epl",
          "match": "->"
        }
      ]
    },
    "keywords-builtin": {
      "patterns": [
        {
          "name": "support.function.io.epl",
          "match": "\\b(Say|Print|Display|Show|Ask|Input|Read|Write|Append)\\b"
        },
        {
          "name": "support.function.call.epl",
          "match": "\\b(Call|New|Super|This)\\b"
        },
        {
          "name": "support.function.collection.epl",
          "match": "\\b(Map|List|Remove|Length|Contains|Replace|Split|Join|Trim)\\b"
        },
        {
          "name": "support.function.web.epl",
          "match": "\\b(Deploy|Observe|Monitor|Wait|Seconds)\\b"
        }
      ]
    },
    "keywords-type": {
      "patterns": [
        {
          "name": "support.type.primitive.epl",
          "match": "\\b(integer|decimal|text|boolean|list|map|nothing|any)\\b"
        }
      ]
    },
    "keywords-constant": {
      "patterns": [
        {
          "name": "constant.language.boolean.epl",
          "match": "\\b(true|false|yes|no)\\b"
        },
        {
          "name": "constant.language.null.epl",
          "match": "\\b(nothing|null)\\b"
        }
      ]
    },
    "keywords-modifier": {
      "patterns": [
        {
          "name": "storage.modifier.access.epl",
          "match": "\\b(Public|Private|Protected|Static|Abstract|Override)\\b"
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "match": "\\b(Function|Define\\s+(?:a\\s+|an\\s+|the\\s+)?Function)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.other.declaration.epl" },
            "2": { "name": "entity.name.function.definition.epl" }
          }
        }
      ]
    },
    "class-def": {
      "patterns": [
        {
          "match": "\\b(Class)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.other.class.epl" },
            "2": { "name": "entity.name.type.class.epl" }
          }
        },
        {
          "match": "\\b(Enum)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.other.class.epl" },
            "2": { "name": "entity.name.type.enum.epl" }
          }
        },
        {
          "match": "\\b(Interface)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.other.class.epl" },
            "2": { "name": "entity.name.type.interface.epl" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.call.epl",
          "match": "\\b([a-z_][a-z0-9_]*)\\s*\\("
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.epl",
          "match": ","
        },
        {
          "name": "punctuation.terminator.period.epl",
          "match": "\\.$"
        },
        {
          "name": "punctuation.section.brackets.begin.epl",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.epl",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.epl",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.epl",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.braces.begin.epl",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.epl",
          "match": "\\}"
        },
        {
          "name": "punctuation.accessor.dot.epl",
          "match": "\\."
        },
        {
          "name": "punctuation.accessor.double-colon.epl",
          "match": "::"
        }
      ]
    }
  }
}
