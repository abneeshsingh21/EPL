            End

            Div class "features-grid"
                Div class "feature-card native-pull-up delay-0"
                    Div class "fc-title"
                        Text "Ecosystem"
                    End
                    Div class "fc-list"
                        Text "A language with a future."
                    End
                End

                Div class "feature-card native-pull-up delay-1"
                    Div class "fc-icon"
                        Text "Aa"
                    End
                    Div class "fc-title"
                        Text "Plain-English Syntax. 01"
                    End
                    Div class "fc-list"
                        Div class "fc-item"
                            Span class "fc-check"
                                Text "✓"
                            End
                            Span class "fc-text"
                                Text "readable syntax"
                            End
                        End
                        Div class "fc-item"
                            Span class "fc-check"
                                Text "✓"
                            End
                            Span class "fc-text"
                                Text "natural language feel"
                            End
                        End
                        Div class "fc-item"
                            Span class "fc-check"
                                Text "✓"
