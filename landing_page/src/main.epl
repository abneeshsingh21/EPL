        Script
            // Character animation setup (still using Script because it requires scroll calculation per rect)
            setTimeout(() => {
                const textContainer = document.getElementById('scroll-text');
                if(textContainer) {
                    const p = textContainer.querySelector('p') || textContainer;
                    const chars = p.textContent.split('');
                    p.innerHTML = '';
                    chars.forEach(c => {
                        const span = document.createElement('span');
                        span.textContent = c;
                        span.className = 'char-span';
                        p.appendChild(span);
                    });

                    window.addEventListener('scroll', () => {
                        const rect = textContainer.getBoundingClientRect();
                        const viewHeight = window.innerHeight;
                        if(rect.top < viewHeight && rect.bottom > 0) {
                            const progress = 1 - (rect.bottom / (viewHeight + rect.height));
                            const spans = textContainer.querySelectorAll('.char-span');
                            const activeCount = Math.floor(progress * spans.length * 1.5);
                            spans.forEach((span, i) => {
                                if(i < activeCount) span.classList.add('active');
                                else span.classList.remove('active');
                            });
                        }
                    });
                }
            }, 100);
        End
    End
End
